{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickbooks-enterprises",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  // By default `wrangler deploy` (run by every git-triggered Cloudflare build) wipes any
  // Runtime variable set via the dashboard — secrets survive, plain variables don't. This was
  // silently deleting MONGODB_URI, MSG91_EMAIL_DOMAIN, PAYDOLLAR_*, etc. on every push.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
